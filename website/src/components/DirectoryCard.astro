---
interface Props {
  name: string;
  description: string;
  type: "skill" | "agent" | "hook" | "command";
  repo: string;
  installCmd: string;
  verified: boolean;
  fromRegistry: boolean;
  stars?: number;
  sourceUrl?: string;
  contentPreview?: string;
}

const { name, description, type, repo, installCmd, verified, fromRegistry, stars, sourceUrl, contentPreview } = Astro.props;

const typeStyles: Record<string, { color: string; label: string }> = {
  skill: { color: "bg-blue-500/10 text-blue-400 border-blue-500/20", label: "Skill" },
  agent: { color: "bg-purple-500/10 text-purple-400 border-purple-500/20", label: "Agent" },
  hook: { color: "bg-orange-500/10 text-orange-400 border-orange-500/20", label: "Hook" },
  command: { color: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20", label: "Command" },
};

const { color: typeColor, label: typeLabel } = typeStyles[type] || typeStyles.skill;
---

<div
  class="preview-trigger group flex h-full cursor-pointer flex-col rounded-xl border border-gray-200 bg-white p-5 transition-all hover:border-gray-300 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-gray-700"
  data-preview-name={name}
  data-preview-description={description}
  data-preview-type={type}
  data-preview-repo={repo}
  data-preview-cmd={installCmd}
  data-preview-verified={String(verified)}
  data-preview-source-url={sourceUrl || ""}
  data-preview-content={contentPreview || ""}
>
  <div class="mb-3 flex items-start justify-between gap-2">
    <div class="flex flex-wrap items-center gap-1.5">
      <span class:list={["inline-flex items-center rounded-full border px-2 py-0.5 text-[11px] font-medium", typeColor]}>
        {typeLabel}
      </span>
      {verified && (
        <span class="inline-flex items-center gap-0.5 rounded-full border border-green-500/20 bg-green-500/10 px-2 py-0.5 text-[11px] font-medium text-green-400">
          <svg class="h-2.5 w-2.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 010-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          Verified
        </span>
      )}
      {fromRegistry && (
        <span class="inline-flex items-center rounded-full border border-amber-500/20 bg-amber-500/10 px-2 py-0.5 text-[11px] font-medium text-amber-400">
          Registry
        </span>
      )}
    </div>
    {stars !== undefined && stars > 0 && (
      <span class="flex shrink-0 items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
        <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401z" clip-rule="evenodd" />
        </svg>
        {stars.toLocaleString()}
      </span>
    )}
  </div>

  <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">{name}</h3>
  <p class="mt-1 line-clamp-2 flex-1 text-xs leading-relaxed text-gray-500 dark:text-gray-400">{description}</p>

  <span class="mt-2 inline-flex items-center gap-1 text-[10px] text-gray-400 opacity-0 transition-opacity group-hover:opacity-100 dark:text-gray-500">
    <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
    Click to preview
  </span>

  <div class="mt-1.5 space-y-1.5">
    <a
      href={`https://github.com/${repo}`}
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-1.5 text-[11px] text-gray-400 transition-colors hover:text-gray-600 dark:text-gray-500 dark:hover:text-gray-300"
    >
      <svg class="h-3 w-3 shrink-0" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
      </svg>
      <span class="truncate">{repo}</span>
    </a>
    <button
      class="copy-cmd flex w-full items-center gap-1.5 overflow-hidden rounded-md border border-gray-200 bg-gray-50 px-2.5 py-1 text-[11px] font-mono text-gray-600 transition-all hover:border-gray-300 hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:border-gray-600 dark:hover:bg-gray-700"
      data-cmd={installCmd}
    >
      <svg class="h-2.5 w-2.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
        <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" />
      </svg>
      <span class="truncate">{installCmd}</span>
    </button>
  </div>
</div>
