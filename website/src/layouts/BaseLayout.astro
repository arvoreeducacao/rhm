---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Give your AI coding assistant the full picture.' } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
let ogSlug = 'home';
if (currentPath.startsWith('/docs/')) {
  ogSlug = currentPath.replace('/docs/', '');
} else if (currentPath.startsWith('/careers')) {
  ogSlug = 'careers';
}

const siteUrl = (Astro.site?.toString() || Astro.url.origin).replace(/\/$/, '');
const ogImageUrl = `${siteUrl}/og/${ogSlug}.png`;
const canonicalUrl = `${siteUrl}${currentPath}`;
const fullTitle = `${title} | Repo Hub`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Repo Hub Releases" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLM-friendly documentation" href="/llms.txt" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{fullTitle}</title>
    <ViewTransitions />
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script is:inline>
      (function() {
        if (typeof navigator !== 'undefined' && navigator.modelContext && navigator.modelContext.provideContext) {
          navigator.modelContext.provideContext({
            tools: [
              {
                name: 'get_documentation',
                description: 'Get the full Repo Hub documentation as a single markdown file, optimized for LLM consumption.',
                inputSchema: { type: 'object', properties: {} },
                execute: async function() {
                  var res = await fetch('/llms-full.txt');
                  return { content: await res.text() };
                }
              },
              {
                name: 'get_releases',
                description: 'Get the latest Repo Hub releases and changelog.',
                inputSchema: { type: 'object', properties: {} },
                execute: async function() {
                  var res = await fetch('/api/releases.json');
                  return { content: JSON.stringify(await res.json()) };
                }
              },
              {
                name: 'search_directory',
                description: 'Search the Repo Hub directory for agents, skills, and MCPs.',
                inputSchema: { type: 'object', properties: {} },
                execute: async function() {
                  var res = await fetch('/directory.json');
                  return { content: JSON.stringify(await res.json()) };
                }
              }
            ]
          });
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <div id="img-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm cursor-zoom-out" role="dialog" aria-modal="true" aria-label="Image preview">
      <img id="img-lightbox-src" class="max-h-[90vh] max-w-[90vw] rounded-xl shadow-2xl bg-white dark:bg-gray-900" alt="" />
    </div>
    <script is:inline>
      (function() {
        var overlay = document.getElementById('img-lightbox');
        var lightboxImg = document.getElementById('img-lightbox-src');
        if (!overlay || !lightboxImg) return;

        document.querySelectorAll('article img, .prose img').forEach(function(img) {
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', function() {
            lightboxImg.src = img.src;
            lightboxImg.alt = img.alt || '';
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
          });
        });

        overlay.addEventListener('click', function() {
          overlay.classList.add('hidden');
          overlay.classList.remove('flex');
          lightboxImg.src = '';
        });

        document.addEventListener('keydown', function(e) {
          if (e.key === 'Escape' && !overlay.classList.contains('hidden')) {
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
            lightboxImg.src = '';
          }
        });
      })();
    </script>
  </body>
</html>
