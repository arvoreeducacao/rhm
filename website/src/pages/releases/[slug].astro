---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const releases = await getCollection("releases");
  return releases.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

function formatDate(dateStr: string) {
  return new Date(dateStr + "T00:00:00").toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="mx-auto max-w-3xl px-6 pt-32 pb-24">
    <div class="mb-10">
      <a
        href="/releases"
        class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-brand-600 transition-colors font-mono tracking-wide dark:text-gray-500 dark:hover:text-brand-400"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6" />
        </svg>
        All Releases
      </a>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-2">
      <span class="inline-flex items-center gap-2 rounded-full border border-gray-200/80 bg-white/60 px-3 py-1 text-xs font-mono text-gray-500 backdrop-blur-sm dark:border-gray-700/80 dark:bg-gray-900/60 dark:text-gray-400">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
        v{entry.data.version}
      </span>
      <time class="text-xs text-gray-400 font-mono dark:text-gray-500">
        {formatDate(entry.data.date)}
      </time>
    </div>

    <article
      class="prose prose-gray max-w-none
        prose-headings:font-semibold prose-headings:tracking-tight
        prose-h1:text-3xl sm:prose-h1:text-4xl prose-h1:text-gray-900
        prose-h2:text-xl prose-h2:text-gray-900 prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-base prose-h3:text-gray-800
        prose-p:text-gray-500 prose-p:leading-relaxed
        prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
        prose-code:text-brand-700 prose-code:bg-brand-50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
        prose-pre:bg-gray-50 prose-pre:border prose-pre:border-gray-200 prose-pre:rounded-xl
        prose-pre:prose-code:text-inherit prose-pre:prose-code:bg-transparent prose-pre:prose-code:p-0
        prose-strong:text-gray-900
        prose-table:border-collapse prose-table:text-sm
        prose-th:border prose-th:border-gray-200 prose-th:bg-gray-50 prose-th:px-4 prose-th:py-2 prose-th:text-gray-700 prose-th:text-sm prose-th:font-medium
        prose-td:border prose-td:border-gray-200 prose-td:px-4 prose-td:py-2 prose-td:text-sm
        prose-li:marker:text-gray-300
        prose-hr:border-gray-100
        dark:prose-invert
        dark:prose-h1:text-gray-100
        dark:prose-h2:text-gray-100
        dark:prose-h3:text-gray-200
        dark:prose-p:text-gray-400
        dark:prose-a:text-brand-400
        dark:prose-code:text-brand-300 dark:prose-code:bg-brand-950/50
        dark:prose-pre:bg-gray-900 dark:prose-pre:border-gray-800
        dark:prose-strong:text-gray-100
        dark:prose-th:border-gray-700 dark:prose-th:bg-gray-900 dark:prose-th:text-gray-300
        dark:prose-td:border-gray-700
        dark:prose-li:marker:text-gray-600
        dark:prose-hr:border-gray-800"
    >
      <Content />
    </article>

    <div class="mt-16 flex items-center justify-between border-t border-gray-100 pt-8 dark:border-gray-800">
      <a
        href="/releases"
        class="text-sm text-gray-400 hover:text-brand-600 transition-colors dark:text-gray-500 dark:hover:text-brand-400"
      >
        &larr; All releases
      </a>
      <a
        href={`https://github.com/arvoreeducacao/rhm/releases/tag/v${entry.data.version}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-400 hover:text-brand-600 transition-colors dark:text-gray-500 dark:hover:text-brand-400"
      >
        View on GitHub &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
