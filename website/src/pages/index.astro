    <script>
      import { createHeroScene } from '../components/HeroScene';
      import { createPipelineScene } from '../components/PipelineScene';

      function initScenes() {
        const el = document.getElementById('mesh');
        if (el) {
          const dispose = createHeroScene(el as HTMLCanvasElement);
          document.addEventListener('astro:before-swap', () => dispose(), { once: true });
        }

        const pipelineEl = document.getElementById('pipeline-canvas');
        if (pipelineEl) {
          const disposePipeline = createPipelineScene(pipelineEl as HTMLCanvasElement);
          document.addEventListener('astro:before-swap', () => disposePipeline(), { once: true });
        }

        const copyBtn = document.getElementById('copy-install');
        if (copyBtn) {
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText('npx @arvoretech/hub init').then(() => {
              const original = copyBtn.textContent;
              copyBtn.textContent = 'Copied!';
              setTimeout(() => { copyBtn.textContent = original; }, 2000);
            });
          });
        }
      }

      initScenes();
      document.addEventListener('astro:after-swap', initScenes);
    </script>

    <script is:inline>
      (function() {
        const container = document.getElementById('config-tabs');
        if (!container) return;

        const tabs = container.querySelectorAll('.config-tab');
        const panels = container.querySelectorAll('[data-panel]');

        tabs.forEach(function(tab) {
          tab.addEventListener('click', function() {
            var target = tab.getAttribute('data-tab');

            tabs.forEach(function(t) { t.classList.remove('config-tab-active'); });
            tab.classList.add('config-tab-active');

            panels.forEach(function(p) {
              p.classList.toggle('hidden', p.getAttribute('data-panel') !== target);
            });
          });
        });
      })();
    </script>

