{
  "name": "@arvoretech/hub-pi",
  "version": "1.5.6",
  "description": "Pi runtime package for hub.yaml workspaces \u2014 interprets config at runtime with no static generation",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsup --clean src/extensions/index.ts --format esm --dts --external typebox --external @earendil-works/pi-coding-agent",
    "prepack": "pnpm build",
    "dev": "tsup src/extensions/index.ts --format esm --watch",
    "test": "vitest --passWithNoTests",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@arvoretech/hub-core": "workspace:*",
    "typebox": "^1.1.38",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.0.0"
  },
  "author": "Arvore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/rhm.git",
    "directory": "packages/pi"
  }
}
