{
  "name": "@arvoretech/manifest",
  "version": "0.1.0",
  "description": "Workspace manifest: declares which skills and MCP servers apply to which repositories",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./schema": "./dist/schema.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --clean src/index.ts src/schema.ts --format esm --dts",
    "dev": "tsup src/index.ts src/schema.ts --format esm --watch",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.0.0"
  },
  "author": "Arvore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/rhm.git",
    "directory": "packages/manifest"
  },
  "keywords": [
    "hub",
    "ai",
    "agent",
    "skills",
    "mcp",
    "manifest"
  ]
}
