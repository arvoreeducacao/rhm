{
  "name": "@arvoretech/hub",
  "version": "0.8.1",
  "description": "CLI for managing AI-aware multi-repository workspaces",
  "main": "dist/index.js",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hub": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "test": "vitest --passWithNoTests",
    "test:cov": "vitest --coverage --passWithNoTests",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "execa": "^9.5.0",
    "fast-glob": "^3.3.0",
    "inquirer": "^12.0.0",
    "ora": "^8.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.0",
    "vitest": "^3.0.0"
  },
  "author": "Arvore",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arvoreeducacao/rhm.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "cli",
    "ai",
    "multi-repo",
    "cursor",
    "mcp",
    "agent-orchestration"
  ]
}
