{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/arvoreeducacao/rhm/main/schemas/hub.schema.json",
  "title": "Repo Hub Manifest",
  "description": "Configuration file for AI-aware multi-repository workspaces",
  "type": "object",
  "required": ["name", "repos"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Workspace name used in generated config files"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the workspace"
    },
    "version": {
      "type": "string",
      "description": "Manifest version (semver)"
    },
    "tools": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Tool version overrides (e.g. node: '20', pnpm: '9')"
    },
    "mise_settings": {
      "type": "object",
      "description": "Mise (formerly rtx) configuration overrides",
      "properties": {
        "experimental": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "repos": {
      "type": "array",
      "minItems": 1,
      "description": "List of repositories managed by this workspace",
      "items": { "$ref": "#/definitions/repo" }
    },
    "services": {
      "type": "array",
      "description": "Docker services for local development (like docker-compose)",
      "items": { "$ref": "#/definitions/service" }
    },
    "env": {
      "type": "object",
      "description": "Environment profiles and overrides",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "object",
          "description": "Named environment profiles (local, staging, prod)",
          "additionalProperties": { "$ref": "#/definitions/envProfile" }
        },
        "overrides": {
          "type": "object",
          "description": "Per-repo per-profile env var overrides",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "example_extras": {
          "type": "object",
          "description": "Extra variables emitted to the generated .env.example, grouped by section name (for vars not referenced by any MCP)",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      }
    },
    "mcps": {
      "type": "array",
      "description": "MCP (Model Context Protocol) tool connections for AI",
      "items": { "$ref": "#/definitions/mcp" }
    },
    "integrations": {
      "type": "object",
      "description": "External integrations",
      "additionalProperties": false,
      "properties": {
        "linear": {
          "type": "object",
          "description": "Linear issue tracker integration",
          "properties": {
            "team": { "type": "string", "description": "Linear team name" },
            "labels": { "type": "array", "items": { "type": "string" }, "description": "Default labels" },
            "link_pattern": { "type": "string", "description": "Link pattern for issues" }
          },
          "additionalProperties": false
        },
        "github": {
          "type": "object",
          "description": "GitHub integration",
          "properties": {
            "org": { "type": "string", "description": "GitHub organization name" },
            "pr_branch_pattern": { "type": "string", "description": "Branch pattern (e.g. {linear_id}-{slug})" },
            "pr_tool": { "type": "string", "enum": ["cli", "mcp"], "default": "cli", "description": "Tool to use for creating PRs: 'cli' (GitHub CLI) or 'mcp' (GitHub MCP)" }
          },
          "additionalProperties": false
        },
        "slack": {
          "type": "object",
          "description": "Slack integration",
          "properties": {
            "channels": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Channel mappings (e.g. prs: '#eng-prs')"
            },
            "templates": {
              "type": "object",
              "additionalProperties": { "type": "string" },
              "description": "Message templates"
            }
          },
          "additionalProperties": false
        },
        "playwright": {
          "type": "object",
          "description": "Playwright browser testing integration",
          "properties": {
            "base_url": { "type": "string", "description": "Base URL for browser tests" }
          },
          "additionalProperties": false
        }
      }
    },
    "hooks": {
      "type": "object",
      "description": "Lifecycle hooks",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/hookEntry" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Custom workspace-level commands"
    },
    "commands_dir": {
      "type": "string",
      "description": "Directory containing custom command scripts"
    },
    "memory": { "$ref": "#/definitions/memory" },
    "remote_sources": {
      "type": "array",
      "description": "Remote skills and steering files fetched during generate (from Notion, URLs, or local paths)",
      "items": { "$ref": "#/definitions/remoteSource" }
    },
    "design": { "$ref": "#/definitions/design" },
    "pi": { "$ref": "#/definitions/pi" },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Workspace-level skills to install and register (specialized knowledge the agent can pull on demand)"
    },
    "workflow": { "$ref": "#/definitions/workflow" }
  },
  "definitions": {
    "repo": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "description": "A repository in the workspace",
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "Repository identifier" },
        "path": { "type": "string", "description": "Local path relative to workspace root" },
        "url": { "type": "string", "description": "Git remote URL" },
        "tech": {
          "type": "string",
          "description": "Primary technology stack",
          "examples": [
            "nestjs", "nextjs", "react", "react-native", "elixir", "phoenix",
            "django", "fastapi", "rails", "spring", "go", "typescript", "python",
            "vue", "svelte", "angular", "express", "koa"
          ]
        },
        "description": { "type": "string", "description": "What this repository does" },
        "display_name": { "type": "string", "description": "Human-friendly name for workspace files (e.g. 'API Árvore (NestJS)')" },
        "env_file": { "type": "string", "description": "Path to environment file" },
        "commands": {
          "type": "object",
          "description": "Repository-specific commands",
          "properties": {
            "install": { "type": "string", "description": "Install dependencies" },
            "dev": { "type": "string", "description": "Start dev server" },
            "build": { "type": "string", "description": "Build project" },
            "lint": { "type": "string", "description": "Run linter" },
            "test": { "type": "string", "description": "Run tests" }
          },
          "additionalProperties": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skill names to attach to this repo's agents"
        },
        "tools": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Repo-specific tool overrides"
        },
        "context_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Markdown files (relative to the hub workspace root) with rich repo context (architecture, conventions, gotchas). Loaded on demand via the hub_repo_context Pi tool, never at startup."
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "description": "A Docker service",
      "properties": {
        "name": { "type": "string", "description": "Service name" },
        "type": { "type": "string", "description": "Special service type (e.g. sandbox for the AIO Sandbox container)" },
        "workspace": { "type": "string", "description": "Path mounted inside a sandbox container (default: the hub root)" },
        "image": { "type": "string", "description": "Docker image (e.g. postgres:16) — required unless type is set" },
        "port": { "type": "integer", "description": "Single port to expose" },
        "ports": { "type": "array", "items": { "type": "integer" }, "description": "Multiple ports" },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Container env vars" }
      }
    },
    "mcp": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "description": "An MCP server connection",
      "properties": {
        "name": { "type": "string", "description": "MCP server name" },
        "description": { "type": "string", "description": "Short human-readable description of what this MCP provides. Shown inline in the orchestrator prompt next to the MCP name." },
        "instructions": { "type": "string", "description": "Detailed instructions for the AI agent on how and when to use this MCP. Rendered as a dedicated subsection in the orchestrator prompt." },
        "package": {
          "type": "string",
          "description": "npm package name for the MCP server",
          "examples": [
            "@arvoretech/postgresql-mcp",
            "@arvoretech/mysql-mcp",
            "@arvoretech/aws-secrets-manager-mcp",
            "@arvoretech/datadog-mcp",
            "@arvoretech/npm-registry-mcp",
            "@arvoretech/tempmail-mcp",
            "@arvoretech/memory-mcp",
            "@arvoretech/launchdarkly-mcp"
          ]
        },
        "url": { "type": "string", "description": "MCP server URL (remote)" },
        "image": { "type": "string", "description": "Docker image (containerized)" },
        "env": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Env vars" },
        "upstreams": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Names of other MCP servers to route through this proxy. The proxy consolidates multiple MCPs into a single connection with mcp_search and mcp_call tools."
        },
        "autoApprove": {
          "oneOf": [
            { "type": "boolean", "description": "When true, auto-approves all tools (equivalent to [\"*\"])" },
            { "type": "array", "items": { "type": "string" }, "description": "List of tool names to auto-approve. Use [\"*\"] to approve all." }
          ],
          "description": "Tools to auto-approve for this MCP server. Set to true or [\"*\"] to approve all tools without confirmation."
        },
        "command": { "type": "string", "description": "Custom command to launch the MCP server (overrides the default npx -y <package>)" },
        "args": { "type": "array", "items": { "type": "string" }, "description": "Arguments passed to the MCP server command" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" }, "description": "HTTP headers sent to a remote (url) MCP server" },
        "auth": {
          "oneOf": [
            { "type": "string", "enum": ["bearer", "oauth"], "description": "Authentication mode for a remote MCP server" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "description": "OAuth configuration with a pre-registered client",
              "properties": {
                "type": { "type": "string", "enum": ["oauth"] },
                "clientId": { "type": "string", "description": "Pre-registered OAuth client id" },
                "clientSecret": { "type": "string", "description": "OAuth client secret (use ${env:VAR})" },
                "scope": { "type": "string", "description": "OAuth scopes" },
                "redirectUri": { "type": "string", "description": "OAuth redirect URI" },
                "clientName": { "type": "string", "description": "Client name used for dynamic registration" },
                "clientUri": { "type": "string", "description": "Client URI used for dynamic registration" },
                "grantType": { "type": "string", "enum": ["authorization_code", "client_credentials"], "description": "OAuth grant type" }
              }
            }
          ],
          "description": "Authentication for a remote MCP server"
        },
        "lifecycle": { "type": "string", "enum": ["lazy", "eager", "keep-alive"], "description": "Process lifecycle strategy for this MCP server" },
        "idleTimeout": { "type": "number", "description": "Seconds of inactivity before an idle MCP server process is stopped" },
        "directTools": {
          "oneOf": [
            { "type": "boolean", "description": "When true, exposes all of this MCP's tools directly (bypassing the proxy search)" },
            { "type": "array", "items": { "type": "string" }, "description": "Tool names to expose directly" }
          ],
          "description": "Tools from this MCP to expose directly in the agent's tool schema"
        },
        "excludeTools": { "type": "array", "items": { "type": "string" }, "description": "Tool names from this MCP to hide from the agent" }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "Team memory configuration — persistent knowledge base for AI context",
      "properties": {
        "path": {
          "type": "string",
          "default": "./memories",
          "description": "Path to the memories directory"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["decisions", "conventions", "incidents", "domain", "gotchas"]
          },
          "default": ["decisions", "conventions", "incidents", "domain", "gotchas"],
          "description": "Memory categories to use"
        },
        "auto_capture": {
          "type": "boolean",
          "default": false,
          "description": "When true, the orchestrator extracts learnings from completed tasks and saves them as memories"
        },
        "enforce": {
          "type": "boolean",
          "default": false,
          "description": "When true, the agent MUST consult team memory (search_memories) at the start of EVERY interaction — not just at the beginning of tasks. This ensures relevant past decisions, conventions, and gotchas are always considered."
        },
        "embedding_model": {
          "type": "string",
          "default": "Xenova/paraphrase-multilingual-MiniLM-L12-v2",
          "description": "HuggingFace model name for semantic search embeddings"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "description": "Design system configuration — local references for UI skills, libraries, icons, and instructions",
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Skill names containing design guidelines (e.g. bonsai-design-system)"
        },
        "libraries": {
          "type": "array",
          "description": "UI libraries with documentation references",
          "items": { "$ref": "#/definitions/designLibrary" }
        },
        "icons": {
          "type": "string",
          "description": "Icon library name (e.g. lucide, phosphor, heroicons)"
        },
        "instructions": {
          "type": "string",
          "description": "General design instructions for the AI agent"
        },
        "enforce": {
          "type": "boolean",
          "description": "When true, generates mandatory design system rules that force the agent to consult design skills before any UI work"
        }
      }
    },
    "pi": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pi runtime extension toggles. Each module of the @arvoretech/hub-pi extension can be enabled or disabled individually. All default to true (full behavior).",
      "properties": {
        "headerBanner": {
          "type": "boolean",
          "description": "Replaces the Pi UI header with the HUB ASCII banner. Default: true"
        },
        "onboarding": {
          "type": "boolean",
          "description": "Workspace health checks at session start and /setup, /env commands. Default: true"
        },
        "autoMcpWiring": {
          "type": "boolean",
          "description": "Automatically rewrites .pi/mcp.json from config on every session start. Disable to manage mcp.json manually. Default: true"
        },
        "injectCapabilities": {
          "type": "boolean",
          "description": "Injects the capabilities prompt (repositories, policies, conventions) into the system prompt at runtime. Disable when AGENTS.md/steering already provide it to avoid double injection. Default: true"
        },
        "hooks": {
          "type": "boolean",
          "description": "Registers config-defined tool_call hooks. Default: true"
        },
        "persona": {
          "type": "boolean",
          "description": "Injects the persona section into the system prompt. Default: true"
        },
        "repoContext": {
          "type": "boolean",
          "description": "Registers the hub_repo_context tool that loads a repo's context_files on demand, plus steering that nudges the agent to call it before working on a repo. Default: true"
        }
      }
    },
    "designLibrary": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "description": "A UI library reference with documentation source",
      "properties": {
        "name": { "type": "string", "description": "Library name (e.g. shadcn, radix, tailwind)" },
        "mcp": { "type": "string", "description": "MCP server name that provides docs (e.g. context7)" },
        "url": { "type": "string", "description": "Documentation URL" },
        "path": { "type": "string", "description": "Local path to documentation" }
      }
    },
    "remoteSource": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "description": "A remote source that gets fetched and installed as a skill or steering file during generate",
      "anyOf": [
        { "required": ["notion_page"] },
        { "required": ["url"] },
        { "required": ["path"] }
      ],
      "properties": {
        "name": { "type": "string", "description": "Identifier for this source (used as filename)" },
        "type": {
          "type": "string",
          "enum": ["skill", "steering"],
          "description": "Whether to install as a skill (with triggers) or steering file"
        },
        "notion_page": { "type": "string", "description": "Notion page URL or ID to fetch content from" },
        "url": { "type": "string", "description": "URL to fetch content from (plain text or markdown)" },
        "path": { "type": "string", "description": "Local file path to use as source" },
        "instructions": { "type": "string", "description": "Additional instructions to prepend to the content" },
        "triggers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Trigger keywords for skills (ignored for steering type)"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional workspace conventions (no enforced pipeline)",
      "properties": {
        "task_folder": { "type": "string", "description": "Task documents directory (default: ./tasks)" },
        "prompt": {
          "type": "object",
          "description": "Prompt customization",
          "properties": {
            "prepend": { "type": "string", "description": "Text to prepend" },
            "append": { "type": "string", "description": "Text to append" },
            "sections": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Custom sections" }
          },
          "additionalProperties": false
        },
        "fact_checker": {
          "type": "boolean",
          "default": false,
          "description": "When true, forces the agent to verify any factual claim about external state (PR status, deploy status, branch state, merge status, etc.) by actually checking with the appropriate tool BEFORE stating it to the user. Prevents hallucinated status reports."
        },
        "pipeline": {
          "deprecated": true,
          "description": "DEPRECATED: removed in the skills-centered model. Ignored at load time (a warning is emitted). Migrate the knowledge it encoded into skills."
        },
        "enforce_workflow": {
          "type": "boolean",
          "deprecated": true,
          "description": "DEPRECATED: removed in the skills-centered model. Ignored at load time (a warning is emitted)."
        }
      }
    },
    "hookEntry": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "description": "A hook entry",
      "properties": {
        "type": { "type": "string", "enum": ["command", "prompt"], "description": "Hook type" },
        "command": { "type": "string", "description": "Shell command to run" },
        "prompt": { "type": "string", "description": "Prompt to inject" },
        "matcher": { "type": "string", "description": "Pattern matcher" },
        "timeout_ms": { "type": "integer", "description": "Timeout in milliseconds" }
      }
    },
    "envProfile": {
      "type": "object",
      "additionalProperties": false,
      "description": "An environment profile",
      "properties": {
        "description": { "type": "string", "description": "Profile description" },
        "services": { "type": "array", "items": { "type": "string" }, "description": "Services to start" },
        "aws_profile": { "type": "string", "description": "AWS CLI profile name" },
        "secrets": {
          "type": "object",
          "description": "AWS Secrets Manager references",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["secret"],
                "properties": {
                  "secret": { "type": "string" },
                  "profile": { "type": "string" }
                }
              }
            ]
          }
        },
        "build_database_url": {
          "type": "object",
          "description": "Database URL construction",
          "additionalProperties": {
            "type": "object",
            "required": ["from_secret"],
            "properties": {
              "from_secret": { "type": "string" },
              "profile": { "type": "string" },
              "vars": {
                "type": "object",
                "properties": {
                  "user": { "type": "string" },
                  "password": { "type": "string" },
                  "host": { "type": "string" },
                  "port": { "type": "string" },
                  "database": { "type": "string" }
                }
              },
              "template": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
